<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="48dp"
    android:orientation="horizontal">
    <ImageButton
        android:id="@+id/argon_certificate_overlap"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/argon_certificates_overlap_button"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/argon_certificate_overlap" />
    <ImageButton
        android:id="@+id/argon_certificate_actions"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:contentDescription="@string/argon_certificates_actions_button"
        android:focusable="true"
        android:padding="12dp"
        android:src="@drawable/argon_certificate_more" />
</LinearLayout>
