package org.chromium.chrome.browser.externalnav;

import android.content.Intent;
import org.chromium.url.GURL;
import org.chromium.components.embedder_support.util.UrlUtilities;

/** Executes the exact production guard; platform dispatch is counted rather than launched. */
public class NavigationFlow {
    public int launches, notices;
    private final Delegate mDelegate = new Delegate();
    private class Delegate {
        public boolean isApplicationInForeground() { return true; }
        public boolean shouldBlockExternalNavigationForUser(GURL url, Intent intent) {
            return ArgonExternalNavigationPolicy.get().shouldBlock(url, intent);
        }
        public void onExternalNavigationBlocked() { notices++; }
    }
    public static class AsyncActionTakenParams {
        public static AsyncActionTakenParams forNoAction() { return new AsyncActionTakenParams(); }
    }
    public static class Params {
        private final GURL url;
        public boolean started, completed, hasCallback=true, background, mainFrame=true, gesture=true;
        public Params(String value) { url=new GURL(value); }
        public GURL getUrl() { return url; }
        public boolean isMainFrame() { return mainFrame; }
        public boolean hasUserGesture() { return gesture; }
        public boolean isBackgroundTabNavigation() { return background; }
        public void onAsyncActionStarted() { started=true; }
        public interface Completion { void onResult(AsyncActionTakenParams value); }
        public Completion getRequiredAsyncActionTakenCallback() {
            if (!started) throw new AssertionError("Callback requested before async state was set");
            return hasCallback ? value -> completed=true : null;
        }
    }
    public static class OverrideUrlLoadingResult {
        public final String action;
        private OverrideUrlLoadingResult(String value) { action=value; }
        public static OverrideUrlLoadingResult forNoOverride() { return new OverrideUrlLoadingResult("web"); }
        public static OverrideUrlLoadingResult forNavigateTab(GURL url, Params params) {
            return new OverrideUrlLoadingResult("fallback:" + url.url);
        }
        public static OverrideUrlLoadingResult forAsyncAction() { return new OverrideUrlLoadingResult("cancel"); }
    }
    public OverrideUrlLoadingResult navigate(Params params, Intent targetIntent, GURL browserFallbackUrl) {
/* USER_GUARD */
        launches++;
        return new OverrideUrlLoadingResult("usual-browser-rules");
    }
}
