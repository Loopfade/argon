// The method under test is copied verbatim from the locked Chromium revision.
#include <cstdlib>
#include <iostream>
#include <memory>
#include <optional>
#include <string>
#include <utility>

#define BUILDFLAG(flag) (flag)
#define SCOPED_CRASH_KEY_BOOL(...) ((void)0)
#define UMA_HISTOGRAM_ENUMERATION(...) ((void)0)

namespace base {
struct TimeTicks {
  static TimeTicks Now() { return {}; }
};
}

struct GURL {
  explicit GURL(const char* value) : value(value) {}
  bool operator==(const GURL&) const = default;

  std::string value;
};

struct NavigationEntryImpl {
  const GURL& GetURL() const { return url; }
  const GURL& GetVirtualURL() const { return virtual_url; }
  bool IsRestored() const { return restored; }
  bool GetHasPostData() const { return has_post_data; }
  bool IsInitialEntryNotForSynchronousAboutBlank() const { return false; }

  GURL url;
  GURL virtual_url;
  bool restored = true;
  bool has_post_data = false;
};

struct BrowserContext {
  bool IsOffTheRecord() const { return off_the_record; }
  bool off_the_record = false;
};

namespace ui {
enum PageTransition { PAGE_TRANSITION_LINK, PAGE_TRANSITION_AUTO_TOPLEVEL };
}

enum class ReloadType { NONE };

class NavigationControllerImpl {
 public:
  enum class NeedsReloadType { kRestoreSession, kRequestedByClient };

  struct LoadURLParams {
    explicit LoadURLParams(const GURL& url) : url(url) {}

    GURL url;
    ui::PageTransition transition_type = ui::PAGE_TRANSITION_LINK;
    bool should_replace_current_entry = false;
  };

  NavigationControllerImpl(const char* url, const char* virtual_url)
      : entries_{std::make_unique<NavigationEntryImpl>(
            NavigationEntryImpl{GURL(url), GURL(virtual_url)})} {}

  void LoadIfNecessary();
  void LoadURLWithParams(const LoadURLParams& params) {
    browser_load = params;
    ++browser_load_count;
    needs_reload_ = false;
  }

  int GetCurrentEntryIndex() const { return last_committed_entry_index_; }
  NavigationEntryImpl* GetLastCommittedEntry() {
    return entries_[last_committed_entry_index_].get();
  }

  void NavigateToExistingPendingEntry(ReloadType,
                                      void*,
                                      std::nullopt_t,
                                      void*,
                                      base::TimeTicks) {
    history_load = pending_entry_;
  }

  std::optional<LoadURLParams> browser_load;
  int browser_load_count = 0;
  NavigationEntryImpl* history_load = nullptr;
  bool needs_reload_ = true;
  NeedsReloadType needs_reload_type_ = NeedsReloadType::kRestoreSession;
  NavigationEntryImpl* pending_entry_ = nullptr;
  std::unique_ptr<NavigationEntryImpl> entry_replaced_by_post_commit_error_;
  BrowserContext context;

 private:
  BrowserContext* browser_context_ = &context;
  std::unique_ptr<NavigationEntryImpl> entries_[1];
  int last_committed_entry_index_ = 0;
  int pending_entry_index_ = -1;
};

void NavigationControllerImpl::LoadIfNecessary() {
  base::TimeTicks actual_navigation_start = base::TimeTicks::Now();
  SCOPED_CRASH_KEY_BOOL("nav_reentrancy_caller1", "LoadIf_pending",
                        !!pending_entry_);
  if (!needs_reload_) {
    return;
  }

  UMA_HISTOGRAM_ENUMERATION("Navigation.LoadIfNecessaryType",
                            needs_reload_type_);

  // Calling Reload() results in ignoring state, and not loading.
  // Explicitly use NavigateToExistingPendingEntry so that the renderer uses the
  // cached state.
  if (entry_replaced_by_post_commit_error_) {
    // If the current entry is a post commit error, we reload the entry it
    // replaced instead. We leave the error entry in place until a commit
    // replaces it, but the pending entry points to the original entry in the
    // meantime. Note that NavigateToExistingPendingEntry is able to handle the
    // case that pending_entry_ != entries_[pending_entry_index_].
    // Note that this handling is similar to
    // `NavigationControllerImpl::Reload()`.
    pending_entry_ = entry_replaced_by_post_commit_error_.get();
    pending_entry_index_ = GetCurrentEntryIndex();
    NavigateToExistingPendingEntry(
        ReloadType::NONE,
        /*initiator_rfh=*/nullptr,
        /*soft_navigation_heuristics_task_id=*/std::nullopt,
        /*navigation_api_key=*/nullptr, actual_navigation_start);
  } else if (pending_entry_) {
    NavigateToExistingPendingEntry(
        ReloadType::NONE,
        /*initiator_rfh=*/nullptr,
        /*soft_navigation_heuristics_task_id=*/std::nullopt,
        /*navigation_api_key=*/nullptr, actual_navigation_start);
  } else if (!GetLastCommittedEntry()
                  ->IsInitialEntryNotForSynchronousAboutBlank()) {
    pending_entry_ = entries_[last_committed_entry_index_].get();
    pending_entry_index_ = last_committed_entry_index_;
    NavigateToExistingPendingEntry(
        ReloadType::NONE,
        /*initiator_rfh=*/nullptr,
        /*soft_navigation_heuristics_task_id=*/std::nullopt,
        /*navigation_api_key=*/nullptr, actual_navigation_start);
  } else {
    // We should never navigate to an existing initial NavigationEntry that is
    // the initial NavigationEntry for the initial empty document that hasn't
    // been overridden by the synchronous about:blank commit, to preserve
    // legacy behavior where trying to reload when the main frame is on the
    // initial empty document won't result in a navigation. See also
    // https://crbug.com/1277414. If there is something to reload, the
    // successful reload will clear the |needs_reload_| flag. Otherwise, just do
    // it here.
    needs_reload_ = false;
  }
}

void Check(bool condition, const char* message) {
  if (!condition) {
    std::cerr << message << '\n';
    std::exit(1);
  }
}

void CheckHistoryLoad(NavigationControllerImpl& controller,
                      NavigationEntryImpl* expected_entry) {
  controller.LoadIfNecessary();
  Check(!controller.browser_load && controller.history_load == expected_entry,
        "ordinary restore must load the expected saved entry");
}

int main() {
  for (const char* alias :
       {"chrome-native://newtab/", "chrome://newtab/", "chrome://argon/"}) {
    NavigationControllerImpl controller("chrome://argon/", alias);
    controller.LoadIfNecessary();
    Check(controller.browser_load.has_value() && !controller.history_load,
          "built-in restored home still reuses saved frame state");
    const auto& load = *controller.browser_load;
    const GURL expected = GURL(alias) == GURL("chrome://argon/")
                              ? GURL(alias)
                              : GURL("chrome://newtab/");
    Check(load.url == expected &&
              load.transition_type == ui::PAGE_TRANSITION_AUTO_TOPLEVEL,
          "restored home must use the standard browser navigation");
    Check(load.should_replace_current_entry,
          "restored home must replace its history entry");
    controller.LoadIfNecessary();
    Check(controller.browser_load_count == 1,
          "restored home must start only one load");
  }

  for (const char* url : {"https://example.test/home", "chrome-native://newtab/",
                         "chrome-extension://example/ntp.html",
                         "chrome://argon/#add-site"}) {
    NavigationControllerImpl controller(url, "chrome://newtab/");
    CheckHistoryLoad(controller, controller.GetLastCommittedEntry());
  }

  NavigationControllerImpl alias_with_fragment("chrome://argon/",
                                               "chrome://newtab/#fragment");
  CheckHistoryLoad(alias_with_fragment,
                   alias_with_fragment.GetLastCommittedEntry());

  NavigationControllerImpl incognito("chrome://argon/", "chrome://newtab/");
  incognito.context.off_the_record = true;
  CheckHistoryLoad(incognito, incognito.GetLastCommittedEntry());

  NavigationControllerImpl crash_reload("chrome://argon/", "chrome://newtab/");
  crash_reload.needs_reload_type_ =
      NavigationControllerImpl::NeedsReloadType::kRequestedByClient;
  CheckHistoryLoad(crash_reload, crash_reload.GetLastCommittedEntry());

  NavigationControllerImpl active("chrome://argon/", "chrome://newtab/");
  active.GetLastCommittedEntry()->restored = false;
  CheckHistoryLoad(active, active.GetLastCommittedEntry());

  NavigationControllerImpl post("chrome://argon/", "chrome://newtab/");
  post.GetLastCommittedEntry()->has_post_data = true;
  CheckHistoryLoad(post, post.GetLastCommittedEntry());

  NavigationEntryImpl site{GURL("https://example.test/"),
                           GURL("https://example.test/")};
  NavigationControllerImpl pending("chrome://argon/", "chrome://newtab/");
  pending.pending_entry_ = &site;
  CheckHistoryLoad(pending, &site);

  NavigationControllerImpl error("chrome://argon/", "chrome://newtab/");
  error.entry_replaced_by_post_commit_error_ =
      std::make_unique<NavigationEntryImpl>(site);
  CheckHistoryLoad(error, error.entry_replaced_by_post_commit_error_.get());

  std::cout << "PASS: restored built-in home replaces its entry through a "
               "fresh navigation\n";
}
