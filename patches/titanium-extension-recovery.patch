+void ExtensionRegistrar::ScheduleCrashedExtensionReload(
+    scoped_refptr<const Extension> extension,
+    base::RepeatingCallback<bool()> can_continue) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  const ExtensionId id = extension->id();
+  if (!delegate_ ||
+      registry_->enabled_extensions().GetByID(id) != extension.get() ||
+      pending_crash_recoveries_.contains(id)) {
+    return;
+  }
+
+  const uint64_t recovery_id = ++next_crash_recovery_id_;
+  pending_crash_recoveries_.emplace(id, recovery_id);
+  if (!base::SingleThreadTaskRunner::GetCurrentDefault()->PostDelayedTask(
+          FROM_HERE,
+          base::BindOnce(&ExtensionRegistrar::ReloadCrashedExtension,
+                         weak_factory_.GetWeakPtr(), std::move(extension),
+                         recovery_id, std::move(can_continue)),
+          base::Seconds(3))) {
+    ClearCrashRecovery(id, recovery_id);
+  }
+}
+
+bool ExtensionRegistrar::IsCurrentCrashRecovery(const Extension& extension,
+                                                uint64_t recovery_id) const {
+  auto it = pending_crash_recoveries_.find(extension.id());
+  return it != pending_crash_recoveries_.end() && it->second == recovery_id &&
+         registry_->terminated_extensions().GetByID(extension.id()) ==
+             &extension;
+}
+
+void ExtensionRegistrar::ClearCrashRecovery(const ExtensionId& extension_id,
+                                             uint64_t recovery_id) {
+  auto it = pending_crash_recoveries_.find(extension_id);
+  if (it != pending_crash_recoveries_.end() && it->second == recovery_id) {
+    pending_crash_recoveries_.erase(it);
+  }
+}
+
+void ExtensionRegistrar::ReloadCrashedExtension(
+    scoped_refptr<const Extension> extension,
+    uint64_t recovery_id,
+    base::RepeatingCallback<bool()> can_continue) {
+  const ExtensionId id = extension->id();
+  auto weak = weak_factory_.GetWeakPtr();
+  base::ScopedClosureRunner clear_recovery(
+      base::BindOnce(&ExtensionRegistrar::ClearCrashRecovery, weak, id,
+                     recovery_id));
+  if (!IsCurrentCrashRecovery(*extension, recovery_id) || !can_continue.Run()) {
+    return;
+  }
+
+  // The unpacked loader runs asynchronously. Keep the same check until the
+  // actual installation, and clear the request even if loading fails.
+  DoReloadExtension(
+      id, LoadErrorBehavior::kQuiet,
+      base::BindOnce(
+          [](base::WeakPtr<ExtensionRegistrar> registrar,
+             scoped_refptr<const Extension> extension, uint64_t recovery_id,
+             base::RepeatingCallback<bool()> can_continue,
+             base::ScopedClosureRunner) {
+            return registrar &&
+                   registrar->IsCurrentCrashRecovery(*extension, recovery_id) &&
+                   can_continue.Run();
+          },
+          weak, std::move(extension), recovery_id, std::move(can_continue),
+          std::move(clear_recovery)));
+}
