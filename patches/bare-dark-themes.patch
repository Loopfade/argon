+TEST(DarkModeFilterTest, AmoledBackgroundKeepsAlphaAndSurfaceContrast) {
+  DarkModeSettings settings;
+  DarkModeFilter filter(settings);
+  const SkColor4f white{1.0f, 1.0f, 1.0f, 0.5f};
+  const SkColor4f result = filter.InvertColorIfNeeded(
+      white, DarkModeFilter::ElementRole::kBackground, true);
+  EXPECT_NEAR(0.0f, result.fR, 0.0001f);
+  EXPECT_NEAR(0.0f, result.fG, 0.0001f);
+  EXPECT_NEAR(0.0f, result.fB, 0.0001f);
+  EXPECT_FLOAT_EQ(white.fA, result.fA);
+  const SkColor4f card = filter.InvertColorIfNeeded(
+      SkColor4f::FromColor(0xFFF5F5F5),
+      DarkModeFilter::ElementRole::kBackground, true);
+  EXPECT_GT(card.fR, result.fR);
+  EXPECT_GT(card.fG, result.fG);
+  EXPECT_GT(card.fB, result.fB);
+}
+
+TEST(DarkModeFilterTest, AmoledBackgroundCacheIsSeparateInBothOrders) {
+  DarkModeSettings settings;
+  for (bool amoled_first : {false, true}) {
+    DarkModeFilter filter(settings);
+    const auto role = DarkModeFilter::ElementRole::kBackground;
+    const SkColor4f first = filter.InvertColorIfNeeded(
+        SkColors::kWhite, role, amoled_first);
+    const SkColor4f second = filter.InvertColorIfNeeded(
+        SkColors::kWhite, role, !amoled_first);
+    EXPECT_EQ(first, filter.InvertColorIfNeeded(
+                         SkColors::kWhite, role, amoled_first));
+    EXPECT_EQ(second, filter.InvertColorIfNeeded(
+                          SkColors::kWhite, role, !amoled_first));
+    EXPECT_NE(first.toSkColor(), second.toSkColor());
+    EXPECT_EQ(2u, filter.GetInvertedColorCacheSizeForTesting());
+    EXPECT_EQ(SK_ColorBLACK, (amoled_first ? first : second).toSkColor());
+    EXPECT_EQ(SkColorSetRGB(0x12, 0x12, 0x12),
+              (amoled_first ? second : first).toSkColor());
+  }
+}
+
+TEST(DarkModeFilterTest, AmoledDoesNotChangeForegroundSvgOrBorders) {
+  DarkModeSettings settings;
+  DarkModeFilter filter(settings);
+  for (auto role : {DarkModeFilter::ElementRole::kForeground,
+                    DarkModeFilter::ElementRole::kSVG,
+                    DarkModeFilter::ElementRole::kBorder,
+                    DarkModeFilter::ElementRole::kSelection}) {
+    for (SkColor4f color : {SkColors::kBlack, SkColors::kWhite,
+                            SkColors::kRed}) {
+      EXPECT_EQ(filter.InvertColorIfNeeded(color, role, false),
+                filter.InvertColorIfNeeded(color, role, true));
+    }
+  }
+  cc::PaintFlags flags;
+  flags.setColor(SkColors::kWhite);
+  auto result = filter.ApplyToFlagsIfNeeded(
+      flags, DarkModeFilter::ElementRole::kBackground,
+      SkColors::kTransparent, true);
+  ASSERT_TRUE(result.has_value());
+  EXPECT_EQ(SK_ColorBLACK, result->getColor4f().toSkColor());
+}
 
